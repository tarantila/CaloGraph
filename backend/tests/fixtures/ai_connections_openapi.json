  "schemas": {
    "ProviderConnectionPage": {
      "properties": {
        "items": {
          "items": {
            "$ref": "#/components/schemas/ProviderConnectionView"
          },
          "type": "array",
          "maxItems": 20,
          "title": "Items"
        },
        "next_after": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next After",
          "description": "Null on the last page; pages reflect live configuration."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "items",
        "next_after"
      ],
      "title": "ProviderConnectionPage"
    },
    "ProviderConnectionPut": {
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 100,
          "minLength": 1,
          "title": "Label"
        },
        "provider_kind": {
          "type": "string",
          "enum": [
            "openai_api",
            "anthropic",
            "gemini",
            "local",
            "gateway"
          ],
          "title": "Provider Kind"
        },
        "model_id": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1,
          "title": "Model Id"
        },
        "base_url": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2048,
              "minLength": 1,
              "format": "uri"
            },
            {
              "type": "null"
            }
          ],
          "title": "Base Url",
          "description": "Required for local/gateway; forbidden for native providers. Saving grants no outbound access."
        },
        "enabled": {
          "type": "boolean",
          "title": "Enabled",
          "default": false
        },
        "timeout_seconds": {
          "type": "integer",
          "maximum": 300.0,
          "minimum": 5.0,
          "title": "Timeout Seconds",
          "default": 60
        },
        "api_key": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 8192,
              "format": "password",
              "writeOnly": true
            },
            {
              "type": "null"
            }
          ],
          "title": "Api Key",
          "description": "Write only: omit to preserve, null to remove, non-empty string to replace.",
          "writeOnly": true
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "label",
        "provider_kind",
        "model_id"
      ],
      "title": "ProviderConnectionPut"
    },
    "ProviderConnectionView": {
      "properties": {
        "id": {
          "type": "string",
