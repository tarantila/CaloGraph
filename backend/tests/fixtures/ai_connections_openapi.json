          "anyOf": [
            {
              "type": "string",
              "maxLength": 2048,
              "minLength": 1,
              "format": "uri"
            },
            {
              "type": "null"
            }
          ],
          "title": "Base Url"
        },
        "enabled": {
          "type": "boolean",
          "title": "Enabled"
        },
        "timeout_seconds": {
          "type": "integer",
          "title": "Timeout Seconds"
        },
