# Development template. Copy to .env and review the installation-specific
# paths and settings before starting CaloGraph.
ENVIRONMENT=development
POSTGRES_DB=calograph
POSTGRES_USER=calograph
# Create these files with scripts/init-secrets.sh. Compose mounts only the
# required file into each service under /run/secrets.
POSTGRES_PASSWORD_FILE=./secrets/postgres_password
SESSION_SECRET_FILE=./secrets/session_secret
RATE_LIMIT_SECRET_FILE=./secrets/rate_limit_secret
CREDENTIAL_ENCRYPTION_KEY_FILE=./secrets/credential_encryption_key
MFA_ENCRYPTION_KEY_FILE=./secrets/mfa_encryption_key

CALOGRAPH_PORT=8180
CALOGRAPH_TIMEZONE=Europe/Berlin
# Compose pulls the public GHCR `latest` images by default. Pin a signed release
# with CALOGRAPH_VERSION=vX.Y.Z for reproducible deployments. `--build` still
# builds the checked-out source locally; docker-compose.dev.yml always uses
# separate local development image names.
# CALOGRAPH_VERSION=v0.2.2
# CALOGRAPH_BACKEND_IMAGE=ghcr.io/tarantila/calograph-backend
# CALOGRAPH_FRONTEND_IMAGE=ghcr.io/tarantila/calograph-frontend
# CALOGRAPH_UID=10001
# CALOGRAPH_GID=10001
# Canonical browser URL used for invitation links. Set this to the public HTTPS
# domain when CaloGraph is served through a reverse proxy.
CALOGRAPH_PUBLIC_URL=http://localhost:8180
COOKIE_SECURE=false
TRUSTED_HOSTS=localhost,127.0.0.1
TRUSTED_ORIGINS=http://localhost:8180,http://127.0.0.1:8180
# Dedicated edge network. Compose derives the backend's exact /32 proxy trust
# from CALOGRAPH_FRONTEND_PROXY_IP; do not configure a broad trusted subnet.
# Override all three values together if this subnet overlaps another network.
CALOGRAPH_EDGE_SUBNET=172.30.0.0/24
CALOGRAPH_EDGE_GATEWAY_IP=172.30.0.1
CALOGRAPH_FRONTEND_PROXY_IP=172.30.0.10
# Development exposes the generated API schema. Keep this false on public
# installations unless an external proxy restricts the documentation routes.
ENABLE_API_DOCS=true
ENABLE_HSTS=false
# This affects only descendants of the exact CaloGraph hostname and must be a
# deliberate domain-wide HTTPS decision.
HSTS_INCLUDE_SUBDOMAINS=false

MAX_JSON_PAYLOAD_BYTES=10485760
MAX_UPLOAD_BYTES=524288000
MAX_ZIP_UNCOMPRESSED_BYTES=2147483648
NGINX_MAX_UPLOAD_BYTES=536870912
BACKEND_TMPFS_BYTES=629145600
MAX_ZIP_ENTRIES=20
MAX_IMPORT_RECORDS=1000000
MAX_IMPORT_SAMPLES=250000
MAX_IMPORT_ERRORS=1000
MAX_IMPORT_UNKNOWN_TYPES=100
IMPORT_BATCH_SIZE=500
RAW_PAYLOAD_RETENTION_DAYS=0
# Failed attempts for one normalized account identifier.
LOGIN_RATE_LIMIT=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
# All login attempts from one IPv4 address or IPv6 /64 network.
LOGIN_IP_RATE_LIMIT=30
LOGIN_IP_RATE_LIMIT_WINDOW_SECONDS=300
PASSWORD_CHANGE_RATE_LIMIT=5
PASSWORD_CHANGE_RATE_LIMIT_WINDOW_SECONDS=900
MFA_RATE_LIMIT=10
MFA_RATE_LIMIT_WINDOW_SECONDS=300
MFA_IP_RATE_LIMIT=30
PASSKEY_IP_RATE_LIMIT=30
PASSKEY_RATE_LIMIT_WINDOW_SECONDS=300
# Browser sessions expire after 24 hours without activity and always after
# 30 days, even when continuously active.
SESSION_IDLE_TIMEOUT_HOURS=24
SESSION_ABSOLUTE_TIMEOUT_DAYS=30
RATE_LIMIT_RETENTION_HOURS=24
IMPORT_RATE_LIMIT=30
IMPORT_RATE_LIMIT_WINDOW_SECONDS=60
IMPORT_IP_RATE_LIMIT=60
FILE_IMPORT_USER_RATE_LIMIT=3
FILE_IMPORT_IP_RATE_LIMIT=6
FILE_IMPORT_RATE_LIMIT_WINDOW_SECONDS=3600
YAZIO_ENABLED=true
YAZIO_CONNECT_TIMEOUT_SECONDS=3.05
YAZIO_READ_TIMEOUT_SECONDS=15
YAZIO_LOGIN_DEADLINE_SECONDS=25
YAZIO_OPERATION_DEADLINE_SECONDS=300
YAZIO_REQUEST_WORKERS=3
YAZIO_RATE_LIMIT=2
YAZIO_RATE_LIMIT_WINDOW_SECONDS=600
YAZIO_MAX_PARALLEL_OPERATIONS=2
YAZIO_CIRCUIT_FAILURE_LIMIT=5
YAZIO_CIRCUIT_WINDOW_SECONDS=600
YAZIO_SCHEDULER_POLL_SECONDS=60
# Maximum random delay added to scheduled requests and retries.
YAZIO_SCHEDULER_JITTER_MINUTES=30

# Backend process settings. These values are consumed by the central
# Dockerfile entrypoint and can be overridden without rebuilding the image.
WEB_CONCURRENCY=2
UVICORN_LOG_LEVEL=info
UVICORN_TIMEOUT_KEEP_ALIVE=5
UVICORN_TIMEOUT_GRACEFUL_SHUTDOWN=30
UVICORN_ACCESS_LOG=true
RUN_MIGRATIONS=true

# Optional container limits. Uncomment after measuring the installation.
# Leaving them unset inherits only Docker-host or parent-cgroup constraints.
# The backend memory ceiling must remain comfortably above BACKEND_TMPFS_BYTES.
# FRONTEND_MEMORY_LIMIT=256m
# FRONTEND_CPU_LIMIT=0.50
# FRONTEND_PIDS_LIMIT=100
# BACKEND_MEMORY_LIMIT=2g
# BACKEND_CPU_LIMIT=2
# BACKEND_PIDS_LIMIT=256
# YAZIO_SCHEDULER_MEMORY_LIMIT=512m
# YAZIO_SCHEDULER_CPU_LIMIT=1
# YAZIO_SCHEDULER_PIDS_LIMIT=128
# POSTGRES_MEMORY_LIMIT=2g
# POSTGRES_CPU_LIMIT=2
# POSTGRES_PIDS_LIMIT=256

# Host-side encrypted backups require age and a public recipients file. Export
# this variable in the shell that runs the backup scripts; do not store the
# private identity on the Docker host unless performing a controlled restore.
# BACKUP_AGE_RECIPIENTS_FILE=/etc/calograph/backup-recipients.txt
