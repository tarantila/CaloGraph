# Copy to .env and replace every value marked CHANGE_ME.
POSTGRES_DB=calograph
POSTGRES_USER=calograph
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://calograph:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/calograph
SESSION_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
RATE_LIMIT_SECRET=CHANGE_ME_ANOTHER_RANDOM_SECRET
# For automatic YAZIO sync, generate once with:
# docker compose run --rm --no-deps backend python -m app.cli generate-credential-key
CREDENTIAL_ENCRYPTION_KEY=

CALOGRAPH_PORT=8180
CALOGRAPH_TIMEZONE=Europe/Berlin
# Canonical browser URL used for invitation links. Set this to the public HTTPS
# domain when CaloGraph is served through a reverse proxy.
CALOGRAPH_PUBLIC_URL=http://localhost:8180
COOKIE_SECURE=false
TRUSTED_HOSTS=localhost,127.0.0.1
TRUSTED_ORIGINS=http://localhost:8180,http://127.0.0.1:8180
# Standard Docker bridge address pool. For a tighter rule, replace this with
# the subnet reported by:
# docker network inspect calograph_internal --format '{{(index .IPAM.Config 0).Subnet}}'
TRUSTED_PROXY_NETWORKS=172.16.0.0/12
ENABLE_HSTS=false

MAX_JSON_PAYLOAD_BYTES=10485760
MAX_UPLOAD_BYTES=1073741824
MAX_ZIP_UNCOMPRESSED_BYTES=2147483648
MAX_ZIP_ENTRIES=20
RAW_PAYLOAD_RETENTION_DAYS=0
LOGIN_RATE_LIMIT=10
IMPORT_RATE_LIMIT=30
YAZIO_SCHEDULER_POLL_SECONDS=60
# Maximum random delay added to scheduled requests and retries.
YAZIO_SCHEDULER_JITTER_MINUTES=30
